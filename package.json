{
  "name": "spicetify-hide-podcasts",
  "version": "3.2.0",
  "description": "Spicetify extension to hide podcasts.",
  "main": "hidePodcasts.js",
  "homepage": "https://github.com/theRealPadster/spicetify-hide-podcasts",
  "repository": {
    "type": "git",
    "url": "git@github.com:theRealPadster/spicetify-hide-podcasts.git"
  },
  "bugs": {
    "url": "https://github.com/theRealPadster/spicetify-hide-podcasts/issues"
  },
  "author": "theRealPadster",
  "license": "GPL-3.0",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "spicetify-creator",
    "build:local": "spicetify-creator --out=. --minify",
    "watch": "spicetify-creator --watch",
    "lint": "eslint --fix src",
    "lint:ci": "eslint src",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "update-types": "curl -s -o src/types/spicetify.d.ts https://raw.githubusercontent.com/spicetify/cli/main/globals.d.ts"
  },
  "engines": {
    "yarn": "please-use-pnpm",
    "npm": "please-use-pnpm",
    "pnpm": ">=9",
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "i18next": "^26.3.0",
    "react-i18next": "^17.0.6",
    "spicetify-creator": "^1.0.17",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "private": true
}
